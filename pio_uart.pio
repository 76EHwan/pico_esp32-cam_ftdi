;
; 8n1 UART on PIO, so the ESP32 link is not tied to the RP2040's UART pin mux.
; Both programs run at 8 PIO cycles per bit: clkdiv = clk_sys / (8 * baud).
;
; Adapted from pico-examples (Copyright (c) 2020 Raspberry Pi (Trading) Ltd,
; SPDX-License-Identifier: BSD-3-Clause).
;

.program uart_tx
.side_set 1 opt

; OUT pin 0 and side-set pin 0 are both mapped to the TX pin.

    pull       side 1 [7]   ; assert stop bit, or stall with the line idle
    set x, 7   side 0 [7]   ; preload bit counter, assert start bit for 8 cycles
bitloop:
    out pins, 1             ; shift 1 bit out of the OSR (LSB first)
    jmp x-- bitloop   [6]   ; 8 cycles per iteration

% c-sdk {
#include "hardware/clocks.h"

static inline void uart_tx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    /* Park the pin high before handing it to PIO, so the line never glitches
     * low - the ESP32 would read that as a start bit. */
    pio_sm_set_pins_with_mask(pio, sm, 1u << pin, 1u << pin);
    pio_sm_set_pindirs_with_mask(pio, sm, 1u << pin, 1u << pin);
    pio_gpio_init(pio, pin);

    pio_sm_config c = uart_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 32);   /* shift right, no autopull */
    sm_config_set_out_pins(&c, pin, 1);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);  /* 8 entries, not 4 */
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (8 * baud));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}


.program uart_rx

; IN pin 0 and the JMP pin are both mapped to the RX pin.

start:
    wait 0 pin 0            ; stall until the start bit arrives
    set x, 7    [10]        ; preload counter, then delay to the middle of bit 0
bitloop:
    in pins, 1              ; sample a data bit
    jmp x-- bitloop [6]     ; 8 cycles per iteration
    jmp pin good_stop       ; stop bit should be high

    irq 4 rel               ; framing error or break: flag it (IRQ 4-7 are
    wait 1 pin 0            ; internal only, no NVIC), wait for idle,
    jmp start               ; and push nothing.

good_stop:
    push                    ; no delay here - leave slack for a fast transmitter

% c-sdk {
#include "hardware/clocks.h"

static inline void uart_rx_program_init(PIO pio, uint sm, uint offset, uint pin, uint baud) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_gpio_init(pio, pin);
    gpio_pull_up(pin);                              /* idle high if unplugged */

    pio_sm_config c = uart_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);                 /* for WAIT and IN  */
    sm_config_set_jmp_pin(&c, pin);                 /* for JMP PIN      */
    /* Shift right (LSB first), explicit push. The byte therefore lands in bits
     * 31:24 of the pushed word - see the DMA read address in the main file. */
    sm_config_set_in_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);  /* 8 entries, not 4 */
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (8 * baud));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
